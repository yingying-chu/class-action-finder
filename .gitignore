# macOS
.DS_Store

# Local Claude Code settings — machine-specific, not part of the distributed skills
.claude/

# Generated scan reports — personal data, local only, never committed or pushed.
# Ignore everything under output/ (any file type) except the .gitkeep placeholder.
skills/class-action-finder/output/*
!skills/class-action-finder/output/.gitkeep

# Finder/editor duplicate artifacts ("foo 2.zip", "foo copy.md") — never intentional
* [0-9].*
* copy.*
* copy [0-9].*

# Python bytecode caches — created by running scripts/, never part of the skill
__pycache__/
*.py[cod]
